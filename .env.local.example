# ============================================
# iBlood Blood Bank Management System
# Environment Variables Configuration
# ============================================
# Copy this file to .env.local and fill in your values

# ============================================
# SUPABASE CONFIGURATION
# ============================================
# Get from: https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ============================================
# MONGODB CONFIGURATION
# ============================================
# Get from: MongoDB Atlas or your MongoDB provider
DATABASE_URL=mongodb+srv://username:password@cluster.mongodb.net/iblood

# ============================================
# APPLICATION CONFIGURATION
# ============================================
# Production URL (Netlify/Vercel URL)
NEXT_PUBLIC_APP_URL=https://your-domain.com
# For local development, use: http://localhost:3000

# Network Configuration
# Add your production IPs/domains for allowed origins
ALLOWED_ORIGINS=your-domain.com,api.your-domain.com

# Node Environment
NODE_ENV=development

# ============================================
# GOOGLE OAUTH CONFIGURATION (Optional)
# ============================================
# Get from: https://console.cloud.google.com/apis/credentials
# Required for "Login with Google" feature
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_OAUTH_REDIRECT_URI=https://your-domain.com/auth/callback/google

# ============================================
# OTP/SMS CONFIGURATION
# ============================================
# OTP delivery order for donor registration:
#   Email (primary) → SMS backup (Twilio → Africa's Talking) → Console (demo)
# SMS providers are OPTIONAL backup channels when email delivery fails.

# --- Twilio (Primary SMS backup provider) ---
# Get credentials from: https://www.twilio.com/try-twilio
# Free tier: $15 credit (~750 SMS)

TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# --- Africa's Talking (Secondary SMS backup provider) ---
# Get credentials from: https://account.africastalking.com/
# Free sandbox: ~50-100 SMS for testing
# Setup guide: https://developer.africastalking.com/

AFRICASTALKING_API_KEY=your_api_key_from_dashboard
AFRICASTALKING_USERNAME=your_username
AFRICASTALKING_SENDER_ID=iBlood

# --- Global SMS Toggle ---
# Set to 'false' to disable SMS backup (OTP will use email only, then console in demo)
SMS_ENABLED=true

# ============================================
# DRIVE OUTREACH (activation)
# ============================================
# When an org admin activates a drive, notify existing donors in that organization.
# Eligible donors receive email + SMS; not-yet-eligible donors receive supporter email + SMS (share link / join as supporter).
# Set to 'false' to disable this job entirely.
DRIVE_OUTREACH_ON_ACTIVATE=true

# When set, used to sign returning-donor RSVP links (/rsvp). Falls back to NEXTAUTH_SECRET if unset.
# Generate a long random string for production.
RSVP_JWT_SECRET=

# ============================================
# EMAIL CONFIGURATION (Gmail App Password - OTP primary)
# ============================================
# Setup:
# 1. Go to Google Account → Security
# 2. Enable 2-Step Verification
# 3. Generate App Password: https://myaccount.google.com/apppasswords
# 4. Use 16-character password (no spaces)
# OPTIONAL - if not configured, will fallback to console

GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=abcdefghijklmnop  # 16 chars, no spaces

# ============================================
# MAILJET BACKUP (Optional - Secondary Backup)
# ============================================
# Get API keys from: https://app.mailjet.com/account/apikeys
# Free tier: 6,000 emails/month (200/day)
# OPTIONAL - only needed if Gmail fails

MAILJET_API_KEY=your-api-key
MAILJET_SECRET_KEY=your-secret-key
MAILJET_FROM_EMAIL=verified-email@yourdomain.com

# ============================================
# CLOUDINARY CONFIGURATION (File Uploads)
# ============================================
# Get from: https://cloudinary.com/users/register/free
# Used for profile pictures, drive images, etc.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your-upload-preset

# ============================================
# ADMIN SETUP CONFIGURATION
# ============================================
# Email for the default super admin account
# This user will be created on first setup
DEFAULT_ADMIN_EMAIL=your-email@example.com

# Comma-separated emails notified when someone requests a new organization (self-signup).
# Falls back to all active super_admin users in MongoDB if unset.
PLATFORM_ADMIN_EMAIL=admin@yourdomain.com

# Used in admin activation emails and OAuth redirects. Must match Supabase Auth → URL Configuration:
# Site URL + Redirect URLs should include:
#   https://your-domain.com/auth/callback
#   https://your-domain.com/auth/reset-password
#   https://your-domain.com/auth/setup-account

# ============================================
# RATE LIMITING (Optional)
# ============================================
# Configure rate limiting for API endpoints
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# ============================================
# SESSION CONFIGURATION (Optional)
# ============================================
# Session cookie settings
SESSION_MAX_AGE=86400000
SESSION_COOKIE_NAME=auth-session-token

# ============================================
# AUDIT LOGGING (Optional)
# ============================================
# Enable/disable audit logging
ENABLE_AUDIT_LOGGING=true

# ============================================
# NOTES:
# ============================================
# 1. Never commit .env.local to version control
# 2. OTP will try: Gmail/Mailjet Email → Twilio SMS → Africa's Talking SMS → Console (demo)
# 3. For demo/testing, OTP is always logged to console as fallback
# 4. Restart dev server after changing environment variables
# 5. All SMS/Email services are OPTIONAL - console fallback always works for testing
# 6. Google OAuth is OPTIONAL - standard email/password auth works without it
# 7. Cloudinary is OPTIONAL - file uploads can be disabled if not needed
# 8. SMS metrics tracking is available at /dashboard/sms-metrics (super_admin & org_admin only)
# ============================================
